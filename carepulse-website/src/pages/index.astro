---
import Layout from '../layouts/Layout.astro';
import BlogCard from '../components/BlogCard.astro';
import DoctorCard from '../components/DoctorCard.astro';
import { getBlogs, getAboutUs, getDoctors } from '../lib/cms';

const [blogs, aboutUs, doctors] = await Promise.all([
  getBlogs(),
  getAboutUs(),
  getDoctors(),
]);

const featuredBlogs = blogs.slice(0, 3);

const specialties = [
  {
    id: 'cardiology',
    name: 'Cardiology & Heart Care',
    desc: 'Advanced ECG, echocardiography, preventive vascular evaluations, and cardiac rehabilitation.',
    department: 'Cardiology',
  },
  {
    id: 'pediatrics',
    name: 'Pediatrics & Child Health',
    desc: 'From newborn neonatal care to adolescent wellness, milestone tracking, and routine vaccinations.',
    department: 'Pediatrics',
  },
  {
    id: 'medicine',
    name: 'General & Internal Medicine',
    desc: 'Comprehensive adult diagnostics, chronic disease management, and full-body preventive health checkups.',
    department: 'General Medicine',
  },
  {
    id: 'dental',
    name: 'Comprehensive Dental Clinic',
    desc: 'Pediatric dentistry, cosmetic restorations, orthodontics, and restorative oral surgery.',
    department: 'Dental',
  },
  {
    id: 'orthopedics',
    name: 'Orthopedics & Joint Care',
    desc: 'Joint replacement, arthroscopic surgery, sports medicine, and specialized rehabilitation therapy.',
    department: 'General Medicine',
  },
  {
    id: 'neuro',
    name: 'Neuropsychiatry & Wellness',
    desc: 'Cognitive behavioral support, neurological evaluations, and burnout mitigation therapies.',
    department: 'General Medicine',
  },
];
---

<Layout title="CarePulse Health | Premier Multispeciality Clinic & Doctor Portal">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-inner">
      <div class="hero-content">
        <div class="section-tag">
          <span class="pulse-indicator"></span>
          Premier Multispeciality Clinic
        </div>
        <h1 class="hero-title">
          Compassionate Healthcare with <span class="highlight-text">Clinical Precision.</span>
        </h1>
        <p class="hero-description">
          Welcome to {aboutUs.clinicName}. {aboutUs.tagline}. Our multidisciplinary team of board-certified specialists delivers evidence-based diagnostics, advanced outpatient surgeries, and holistic wellness programs.
        </p>

        <div class="hero-actions">
          <a href="/contact-us" class="btn btn-primary hero-btn">
            <!-- Lucide Calendar Icon -->
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line>
              <line x1="8" y1="2" x2="8" y2="6"></line>
              <line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Book Patient Consultation
          </a>
          <a href="/blogs" class="btn btn-outline hero-btn">
            <!-- Lucide BookOpen Icon -->
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            Read Health Tips
          </a>
        </div>

        <!-- Dynamic Key Stats from CMS -->
        <div class="hero-stats">
          <div class="stat-box">
            <span class="stat-number">{aboutUs.keyStats.yearsOfExperience}+</span>
            <span class="stat-label">Years Clinical Excellence</span>
          </div>
          <div class="stat-separator"></div>
          <div class="stat-box">
            <span class="stat-number">{aboutUs.keyStats.specialistDoctors}+</span>
            <span class="stat-label">Board-Certified Specialists</span>
          </div>
          <div class="stat-separator"></div>
          <div class="stat-box">
            <span class="stat-number">{aboutUs.keyStats.happyPatients}</span>
            <span class="stat-label">Satisfied Patients</span>
          </div>
        </div>
      </div>

      <!-- Hero Visual with NO overlapping / clean contained card layout -->
      <div class="hero-visual">
        <div class="visual-card">
          <!-- Top Floating Rating Pill cleanly contained inside the photo container -->
          <div class="visual-top-badge">
            <div class="star-badge-icon">
              <!-- Official Lucide Star Icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="#f59e0b" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
              </svg>
            </div>
            <div class="star-badge-text">
              <strong>4.9 / 5.0 Rating</strong>
              <span>8,000+ Reviews</span>
            </div>
          </div>

          <div class="visual-image-box">
            <img
              src="https://images.pexels.com/photos/8376277/pexels-photo-8376277.jpeg?auto=compress&cs=tinysrgb&w=1200"
              alt="CarePulse Medical Team"
              class="hero-doctor-img"
              width="600"
              height="450"
              loading="eager"
            />
            <div class="hero-img-gradient"></div>
            <div class="clinic-stamp-overlay">
              <span class="accreditation-pill">
                <!-- Official Lucide ShieldCheck Icon -->
                <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
                NABH & JCI Accredited
              </span>
              <h4>{aboutUs.clinicName}</h4>
              <p>Top Rated Multispeciality Sanctuary</p>
            </div>
          </div>

          <!-- Bottom Emergency Bar cleanly docked with zero leakage -->
          <div class="visual-emergency-bar">
            <div class="emergency-icon-circle">
              <!-- Official Lucide PhoneCall Icon -->
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                <path d="M14.05 2a9 9 0 0 1 8 7.94"/>
                <path d="M14.05 6A5 5 0 0 1 18 10"/>
              </svg>
            </div>
            <div class="emergency-info">
              <strong>Emergency Desk: (800) 247-PULSE</strong>
              <span>Immediate Ambulance Dispatch</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Specialties Section with 100% Lucide Icons -->
  <section class="section specialties-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">Clinical Departments</span>
        <h2 class="section-title">Specialized Care for Every Generation</h2>
        <p class="section-description centered">
          Our clinic unites multiple medical disciplines under one facility to deliver prompt diagnoses, cross-functional consultations, and tailored therapy plans.
        </p>
      </div>

      <div class="specialties-grid">
        {specialties.map((spec) => (
          <div class="specialty-card">
            <div class="specialty-icon-box">
              {spec.id === 'cardiology' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.48 12H2"/>
                </svg>
              )}
              {spec.id === 'pediatrics' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 12h.01"/>
                  <path d="M15 12h.01"/>
                  <path d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5"/>
                  <path d="M19 6.3a9 9 0 0 1 1.8 3.9 2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1"/>
                </svg>
              )}
              {spec.id === 'medicine' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/>
                  <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4"/>
                  <circle cx="20" cy="10" r="2"/>
                </svg>
              )}
              {spec.id === 'dental' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                  <path d="M5 3v4"/>
                  <path d="M19 17v4"/>
                  <path d="M3 5h4"/>
                  <path d="M17 19h4"/>
                </svg>
              )}
              {spec.id === 'orthopedics' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 10c.7-.7 1.6-1 2.5-1a3.5 3.5 0 1 1 0 7c-.9 0-1.8-.3-2.5-1l-10-10C6.3 4.3 5.4 4 4.5 4a3.5 3.5 0 1 0 0 7c.9 0 1.8.3 2.5 1z"/>
                </svg>
              )}
              {spec.id === 'neuro' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/>
                  <path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/>
                  <path d="M12 5v14"/>
                </svg>
              )}
            </div>
            <h3 class="specialty-name">{spec.name}</h3>
            <p class="specialty-desc">{spec.desc}</p>
            <a href={`/contact-us?dept=${encodeURIComponent(spec.department)}`} class="specialty-link">
              <span>Book Department</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Latest Health Blogs / Articles Section -->
  <section class="section blogs-section">
    <div class="container">
      <div class="section-header-row">
        <div>
          <span class="section-tag">Doctor's Journal</span>
          <h2 class="section-title">Latest Health Advice & Clinical Tips</h2>
          <p class="section-description">
            Evidence-based medical articles and wellness strategies written directly by our attending physicians.
          </p>
        </div>
        <a href="/blogs" class="btn btn-outline view-all-btn">
          View All Health Tips
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <div class="blogs-grid">
        {featuredBlogs.map((blog) => (
          <BlogCard blog={blog} />
        ))}
      </div>
    </div>
  </section>

  <!-- Doctors Highlight Section -->
  <section class="section doctors-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">Medical Leadership</span>
        <h2 class="section-title">Meet Our Distinguished Specialists</h2>
        <p class="section-description centered">
          Our physicians bring decades of fellowship experience from top medical institutions worldwide.
        </p>
      </div>

      <div class="doctors-grid">
        {doctors.map((doctor) => (
          <DoctorCard {...doctor} />
        ))}
      </div>

      <div class="doctor-cta-footer text-center">
        <p>Looking for a specific sub-specialist or pediatric surgeon?</p>
        <a href="/about-us" class="learn-more-link">
          Explore All {aboutUs.keyStats.specialistDoctors}+ Doctors on Our Clinical Staff →
        </a>
      </div>
    </div>
  </section>

  <!-- Call to Action Banner -->
  <section class="cta-section">
    <div class="container">
      <div class="cta-banner">
        <div class="cta-content">
          <span class="cta-tag">Immediate Access</span>
          <h2 class="cta-title">Prioritize Your Health with CarePulse Today</h2>
          <p class="cta-desc">
            Convenient online appointment booking, digital records, minimal waiting times, and compassionate patient care.
          </p>
          <div class="cta-buttons">
            <a href="/contact-us" class="btn btn-primary">
              Schedule Appointment Now
            </a>
            <a href="tel:8002477857" class="btn btn-outline-white">
              Call Hotline: (800) 247-PULSE
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-section {
    padding: 4.5rem 0 5rem;
    background: radial-gradient(circle at 10% 20%, rgba(224, 242, 254, 0.6) 0%, rgba(248, 250, 252, 1) 90%);
    position: relative;
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .hero-title {
    font-size: clamp(2.35rem, 4.2vw, 3.4rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--dark);
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
  }

  .highlight-text {
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-description {
    font-size: 1.12rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.75rem;
  }

  .hero-btn {
    padding: 0.85rem 1.6rem;
    font-size: 0.95rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  .stat-box {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--dark);
    line-height: 1.1;
  }

  .stat-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
    font-weight: 600;
  }

  .stat-separator {
    width: 1px;
    height: 36px;
    background-color: var(--border);
  }

  /* Hero Visual - Zero Overlap Layout */
  .hero-visual {
    position: relative;
    width: 100%;
    max-width: 520px;
    margin-left: auto;
  }

  .visual-card {
    position: relative;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: 0 20px 35px -10px rgba(15, 23, 42, 0.12);
  }

  .visual-top-badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 10;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: var(--radius-full);
    padding: 0.35rem 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(8px);
  }

  .star-badge-icon {
    display: flex;
    align-items: center;
  }

  .star-badge-text {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
  }

  .star-badge-text strong {
    font-size: 0.8rem;
    color: var(--dark);
    font-weight: 700;
  }

  .star-badge-text span {
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .visual-image-box {
    position: relative;
    width: 100%;
    height: 390px;
    overflow: hidden;
    background-color: #f1f5f9;
  }

  .hero-doctor-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 25%;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .visual-card:hover .hero-doctor-img {
    transform: scale(1.03);
  }

  .hero-img-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.92) 0%, rgba(15, 23, 42, 0.15) 50%, rgba(15, 23, 42, 0) 100%);
    pointer-events: none;
  }

  .clinic-stamp-overlay {
    position: absolute;
    bottom: 1.25rem;
    left: 1.25rem;
    right: 1.25rem;
    text-align: left;
    color: #ffffff;
    z-index: 2;
  }

  .accreditation-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(2, 132, 199, 0.92);
    color: #ffffff;
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.22rem 0.65rem;
    border-radius: var(--radius-full);
    backdrop-filter: blur(4px);
    margin-bottom: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .clinic-stamp-overlay h4 {
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.15rem;
  }

  .clinic-stamp-overlay p {
    font-size: 0.82rem;
    color: #bae6fd;
    font-weight: 500;
  }

  .visual-emergency-bar {
    background: #0f172a;
    color: #ffffff;
    padding: 0.85rem 1.25rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .emergency-icon-circle {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(56, 189, 248, 0.15);
    color: #38bdf8;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .emergency-info strong {
    display: block;
    font-size: 0.88rem;
    color: #ffffff;
    font-weight: 700;
  }

  .emergency-info span {
    font-size: 0.74rem;
    color: #94a3b8;
  }

  /* Sections */
  .section {
    padding: 5rem 0;
  }

  .section-header.text-center {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-description.centered {
    margin-left: auto;
    margin-right: auto;
  }

  .specialties-section {
    background-color: #ffffff;
  }

  .specialties-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.75rem;
  }

  .specialty-card {
    background-color: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.25rem 2rem;
    transition: var(--transition);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
  }

  .specialty-card:hover {
    transform: translateY(-4px);
    border-color: #bae6fd;
    box-shadow: var(--shadow-lg);
  }

  .specialty-icon-box {
    width: 52px;
    height: 52px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    transition: var(--transition);
  }

  .specialty-card:hover .specialty-icon-box {
    background: var(--primary);
    color: #ffffff;
    transform: scale(1.08);
  }

  .specialty-name {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 0.75rem;
  }

  .specialty-desc {
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .specialty-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--primary);
  }

  .specialty-link:hover {
    color: var(--primary-hover);
    transform: translateX(3px);
  }

  /* Blogs Section */
  .blogs-section {
    background-color: var(--bg-page);
  }

  .section-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 3rem;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .blogs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
  }

  .view-all-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Doctors Section */
  .doctors-section {
    background-color: #ffffff;
