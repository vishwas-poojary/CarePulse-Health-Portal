---
import Layout from '../layouts/Layout.astro';
import DoctorCard from '../components/DoctorCard.astro';
import RichText from '../components/RichText.astro';
import { getAboutUs, getDoctors } from '../lib/cms';

const [aboutUs, doctors] = await Promise.all([
  getAboutUs(),
  getDoctors(),
]);

const facilities = [
  {
    id: 'standards',
    title: 'NABH & JCI Accredited Standards',
    desc: 'Exceeding rigorous international surgical protocols, hospital hygiene standards, and patient safety guidelines.',
  },
  {
    id: 'trauma',
    title: '24/7 Level 1 Trauma & Intensive Care',
    desc: 'Fully equipped multidisciplinary ICU with round-the-clock intensivists and emergency response paramedics.',
  },
  {
    id: 'imaging',
    title: 'High-Resolution Diagnostic Imaging',
    desc: 'Low-dose digital X-ray, high-field MRI, 128-slice CT scans, and point-of-care cardiac ultrasound suites.',
  },
  {
    id: 'records',
    title: 'Fully Digital Electronic Health Records',
    desc: 'Seamless, encrypted patient chart sharing ensuring zero lost tests, fast second opinions, and patient privacy.',
  },
];
---

<Layout
  title={`About Us | ${aboutUs.clinicName}`}
  description={`${aboutUs.clinicName} - ${aboutUs.tagline}. Discover our clinical history, mission, vision, key statistics, and distinguished medical faculty.`}
>
  <!-- About Hero -->
  <section class="about-hero">
    <div class="container text-center">
      <span class="section-tag">About Our Healthcare Sanctuary</span>
      <h1 class="about-hero-title">{aboutUs.clinicName}</h1>
      <p class="about-hero-tagline">{aboutUs.tagline}</p>

      <!-- Key Stats Bar -->
      <div class="about-stats-grid">
        <div class="stat-card">
          <span class="stat-num">{aboutUs.keyStats.yearsOfExperience}+</span>
          <span class="stat-lbl">Years of Clinical Excellence</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">{aboutUs.keyStats.specialistDoctors}+</span>
          <span class="stat-lbl">Board-Certified Physicians</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">{aboutUs.keyStats.happyPatients}</span>
          <span class="stat-lbl">Treated Patients & Families</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">99.4%</span>
          <span class="stat-lbl">Positive Clinical Outcomes</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Clinic Story & Background -->
  <section class="section story-section">
    <div class="container">
      <div class="story-grid">
        <div class="story-content">
          <span class="section-tag">Our History & Heritage</span>
          <h2 class="section-title">Built on Compassion, Driven by Science</h2>
          {aboutUs.story ? (
            <div class="story-rich-body">
              <RichText content={aboutUs.story} />
            </div>
          ) : (
            <p class="story-fallback">
              Founded with a singular commitment to bring world-class healthcare to our community, CarePulse Health delivers multi-disciplinary diagnostics, compassionate nursing, and individualized therapeutic recovery.
            </p>
          )}
        </div>

        <div class="story-card-box">
          <div class="story-photo-wrapper">
            <img
              src="https://images.pexels.com/photos/7088530/pexels-photo-7088530.jpeg?auto=compress&cs=tinysrgb&w=1000"
              alt="CarePulse Physicians Reviewing Clinical Scans"
              class="story-photo"
              loading="lazy"
              width="600"
              height="380"
            />
            <div class="story-photo-caption">
              <span>Multidisciplinary Clinical Review</span>
            </div>
          </div>

          <div class="core-values-card">
            <h3>Our Clinical Commitments</h3>
            <ul class="values-list">
              <li>
                <strong>Patient-Centric Care:</strong> Every treatment protocol is formulated around your physical and emotional well-being.
              </li>
              <li>
                <strong>Zero Diagnostic Compromise:</strong> We leverage state-of-the-art laboratory testing and digital ultrasound technology.
              </li>
              <li>
                <strong>Transparent Communication:</strong> Transparent medical fees, detailed doctor explanations, and prompt patient callbacks.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Vision Section -->
  <section class="section mission-vision-section">
    <div class="container">
      <div class="mission-vision-grid">
        <div class="mv-card mission-card">
          <div class="mv-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="6"/>
              <circle cx="12" cy="12" r="2"/>
            </svg>
          </div>
          <h3>Our Mission</h3>
          <p>{aboutUs.mission}</p>
        </div>
        <div class="mv-card vision-card">
          <div class="mv-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
          </div>
          <h3>Our Vision</h3>
          <p>{aboutUs.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Specialist Doctor Profiles -->
  <section class="section team-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">Clinical Leadership</span>
        <h2 class="section-title">Board-Certified Doctors & Specialists</h2>
        <p class="section-description centered">
          Our senior clinical faculty is comprised of recognized leaders in cardiology, neonatology, internal diagnostics, and reconstructive dentistry.
        </p>
      </div>

      <div class="doctors-grid">
        {doctors.map((doc) => (
          <DoctorCard {...doc} />
        ))}
      </div>
    </div>
  </section>

  <!-- Facilities & Accreditation -->
  <section class="section facilities-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">Modern Infrastructure</span>
        <h2 class="section-title">World-Class Facilities & Accreditation</h2>
        <p class="section-description centered">
          Designed to ensure clinical precision, infection control, and maximum patient comfort during every visit.
        </p>
      </div>

      <div class="facilities-grid">
        {facilities.map((fac) => (
          <div class="facility-card">
            <div class="facility-icon">
              {fac.id === 'standards' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              )}
              {fac.id === 'trauma' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.48 12H2"/>
                </svg>
              )}
              {fac.id === 'imaging' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 18h8"/>
                  <path d="M3 22h18"/>
                  <path d="m14 13 4 4"/>
                  <circle cx="12" cy="6" r="4"/>
                  <path d="M12 10v4"/>
                </svg>
              )}
              {fac.id === 'records' && (
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
                  <path d="M14 2v4a2 2 0 0 0 2 2h4"/>
                  <path d="M10 9H8"/>
                  <path d="M16 13H8"/>
                  <path d="M16 17H8"/>
                </svg>
              )}
            </div>
            <h3 class="facility-title">{fac.title}</h3>
            <p class="facility-desc">{fac.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Box -->
  <section class="section cta-section">
    <div class="container">
      <div class="about-cta-card text-center">
        <h2>Experience Healthcare That Puts You First</h2>
        <p>Our consultation desks are open six days a week, with round-the-clock emergency care.</p>
        <div class="btn-group">
          <a href="/contact-us" class="btn btn-primary">
            Schedule a Consultation
          </a>
          <a href="tel:8002477857" class="btn btn-outline">
            Call Emergency Desk: (800) 247-PULSE
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    background: radial-gradient(circle at 50% 20%, rgba(224, 242, 254, 0.6) 0%, rgba(248, 250, 252, 1) 100%);
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--border);
  }

  .about-hero-title {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    font-weight: 800;
    color: var(--dark);
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
  }

  .about-hero-tagline {
    font-size: 1.25rem;
    color: var(--primary);
    font-weight: 600;
    margin-bottom: 3.5rem;
  }

  .about-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .stat-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.25rem;
    box-shadow: var(--shadow-md);
  }

  .stat-num {
    display: block;
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--dark);
    line-height: 1.1;
    margin-bottom: 0.35rem;
  }

  .stat-lbl {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  /* Story Section */
  .story-section {
    background-color: #ffffff;
    padding: 5rem 0;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }

  .story-rich-body {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text-main);
  }

  .story-photo-wrapper {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-md);
    background-color: #f1f5f9;
    height: 260px;
  }

  .story-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transition: transform 0.4s ease;
  }

  .story-photo-wrapper:hover .story-photo {
    transform: scale(1.03);
  }

  .story-photo-caption {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background: rgba(15, 23, 42, 0.85);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    backdrop-filter: blur(4px);
  }

  .core-values-card {
    background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
    border: 1.5px solid var(--primary-subtle);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
  }

  .core-values-card h3 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--dark);
    margin-bottom: 1.5rem;
  }

  .values-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .values-list li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-main);
  }

  .values-list strong {
    color: var(--primary-hover);
    display: block;
    margin-bottom: 0.2rem;
  }

  /* Mission & Vision */
  .mission-vision-section {
    background-color: var(--bg-page);
    padding: 5rem 0;
  }

  .mission-vision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .mv-card {
    background-color: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 3rem 2.5rem;
    box-shadow: var(--shadow-md);
  }

  .mv-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .mv-card h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--dark);
    margin-bottom: 1rem;
  }

  .mv-card p {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* Team Section */
  .team-section {
    background-color: #ffffff;
    padding: 5rem 0;
  }

  .doctors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-top: 3.5rem;
  }

  /* Facilities */
  .facilities-section {
    background-color: var(--bg-page);
    padding: 5rem 0;
  }

  .facilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.75rem;
    margin-top: 3.5rem;
  }

  .facility-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .facility-icon {
    font-size: 2.25rem;
    display: block;
    margin-bottom: 1rem;
  }

  .facility-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 0.5rem;
  }

  .facility-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* CTA Box */
  .about-cta-card {
    background: linear-gradient(135deg, var(--dark) 0%, #1e293b 100%);
    border-radius: var(--radius-xl);
    padding: 4rem 2rem;
    color: #ffffff;
  }

  .about-cta-card h2 {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .about-cta-card p {
    font-size: 1.1rem;
    color: #94a3b8;
    margin-bottom: 2rem;
  }

  .btn-group {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .mission-vision-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
