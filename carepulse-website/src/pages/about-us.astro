---
import Layout from '../layouts/Layout.astro';
import DoctorCard from '../components/DoctorCard.astro';
import RichText from '../components/RichText.astro';
import { getAboutUs } from '../lib/cms';

const aboutUs = await getAboutUs();

const doctors = [
  {
    name: 'Dr. Sarah Jenkins, MD, FACC',
    title: 'Senior Consultant & Chief of Cardiology',
    department: 'Cardiology',
    experience: '16+ Years',
    focus: 'Preventive Cardiology, 4D Echocardiography, Angiography',
  },
  {
    name: 'Dr. Marcus Vance, FAAP',
    title: 'Chief Pediatrician & Neonatologist',
    department: 'Pediatrics',
    experience: '14+ Years',
    focus: 'Pediatric Pulmonology, Neonatal Intensive Care, Immunization',
  },
  {
    name: 'Dr. Aris Thorne, MD',
    title: 'Lead Internist & Preventive Medicine Specialist',
    department: 'General Medicine',
    experience: '12+ Years',
    focus: 'Metabolic Syndrome, Chronic Care, Preventive Geriatrics',
  },
  {
    name: 'Dr. Chloe Martinez, DDS',
    title: 'Chief Dental & Orthodontic Surgeon',
    department: 'Dental',
    experience: '10+ Years',
    focus: 'Aesthetic Dentistry, Dental Implants, Pediatric Orthodontics',
  },
  {
    name: 'Dr. Elena Rostova, PhD, MD',
    title: 'Head of Neuropsychiatry & Cognitive Health',
    department: 'General Medicine',
    experience: '15+ Years',
    focus: 'Clinical Neuroscience, Sleep Medicine, Stress Mitigation',
  },
  {
    name: 'Dr. Liam Montgomery, MD, FACS',
    title: 'Lead Orthopedic & Sports Medicine Surgeon',
    department: 'General Medicine',
    experience: '18+ Years',
    focus: 'Minimally Invasive Joint Replacement, Sports Injury Rehab',
  },
];

const facilities = [
  {
    title: 'NABH & JCI Accredited Standards',
    desc: 'Exceeding rigorous international surgical protocols, hospital hygiene standards, and patient safety guidelines.',
    icon: '🏥',
  },
  {
    title: '24/7 Level 1 Trauma & Intensive Care',
    desc: 'Fully equipped multidisciplinary ICU with round-the-clock intensivists and emergency response paramedics.',
    icon: '🚑',
  },
  {
    title: 'High-Resolution Diagnostic Imaging',
    desc: 'Low-dose digital X-ray, high-field MRI, 128-slice CT scans, and point-of-care cardiac ultrasound suites.',
    icon: '🔬',
  },
  {
    title: 'Fully Digital Electronic Health Records',
    desc: 'Seamless, encrypted patient chart sharing ensuring zero lost tests, fast second opinions, and patient privacy.',
    icon: '💻',
  },
];
---

<Layout
  title={`About Us | ${aboutUs.clinicName}`}
  description={`${aboutUs.clinicName} - ${aboutUs.tagline}. Discover our clinical history, mission, vision, key statistics, and distinguished medical faculty.`}
>
  <!-- About Hero -->
  <section class="about-hero">
    <div class="container text-center">
      <span class="section-tag">About Our Healthcare Sanctuary</span>
      <h1 class="about-hero-title">{aboutUs.clinicName}</h1>
      <p class="about-hero-tagline">{aboutUs.tagline}</p>

      <!-- Key Stats Bar -->
      <div class="about-stats-grid">
        <div class="stat-card">
          <span class="stat-num">{aboutUs.keyStats.yearsOfExperience}+</span>
          <span class="stat-lbl">Years of Clinical Excellence</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">{aboutUs.keyStats.specialistDoctors}+</span>
          <span class="stat-lbl">Board-Certified Physicians</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">{aboutUs.keyStats.happyPatients}</span>
          <span class="stat-lbl">Treated Patients & Families</span>
        </div>
        <div class="stat-card">
          <span class="stat-num">99.4%</span>
          <span class="stat-lbl">Positive Clinical Outcomes</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Clinic Story & Background -->
  <section class="section story-section">
    <div class="container">
      <div class="story-grid">
        <div class="story-content">
          <span class="section-tag">Our History & Heritage</span>
          <h2 class="section-title">Built on Compassion, Driven by Science</h2>
          {aboutUs.story ? (
            <div class="story-rich-body">
              <RichText content={aboutUs.story} />
            </div>
          ) : (
            <p class="story-fallback">
              Founded with a singular commitment to bring world-class healthcare to our community, CarePulse Health delivers multi-disciplinary diagnostics, compassionate nursing, and individualized therapeutic recovery.
            </p>
          )}
        </div>

        <div class="story-card-box">
          <div class="core-values-card">
            <h3>Our Clinical Commitments</h3>
            <ul class="values-list">
              <li>
                <strong>Patient-Centric Care:</strong> Every treatment protocol is formulated around your physical and emotional well-being.
              </li>
              <li>
                <strong>Zero Diagnostic Compromise:</strong> We leverage state-of-the-art laboratory testing and digital ultrasound technology.
              </li>
              <li>
                <strong>Transparent Communication:</strong> Transparent medical fees, detailed doctor explanations, and prompt patient callbacks.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission & Vision Section -->
  <section class="section mission-vision-section">
    <div class="container">
      <div class="mission-vision-grid">
        <div class="mv-card mission-card">
          <div class="mv-icon">🎯</div>
          <h3>Our Mission</h3>
          <p>{aboutUs.mission}</p>
        </div>
        <div class="mv-card vision-card">
          <div class="mv-icon">🌟</div>
          <h3>Our Vision</h3>
          <p>{aboutUs.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Specialist Doctor Profiles -->
  <section class="section team-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">Clinical Leadership</span>
        <h2 class="section-title">Board-Certified Doctors & Specialists</h2>
        <p class="section-description centered">
          Our senior clinical faculty is comprised of recognized leaders in cardiology, neonatology, internal diagnostics, and reconstructive dentistry.
        </p>
      </div>

      <div class="doctors-grid">
        {doctors.map((doc) => (
          <DoctorCard {...doc} />
        ))}
      </div>
    </div>
  </section>

  <!-- Facilities & Accreditation -->
  <section class="section facilities-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">Modern Infrastructure</span>
        <h2 class="section-title">World-Class Facilities & Accreditation</h2>
        <p class="section-description centered">
          Designed to ensure clinical precision, infection control, and maximum patient comfort during every visit.
        </p>
      </div>

      <div class="facilities-grid">
        {facilities.map((fac) => (
          <div class="facility-card">
            <span class="facility-icon">{fac.icon}</span>
            <h3 class="facility-title">{fac.title}</h3>
            <p class="facility-desc">{fac.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Box -->
  <section class="section cta-section">
    <div class="container">
      <div class="about-cta-card text-center">
        <h2>Experience Healthcare That Puts You First</h2>
        <p>Our consultation desks are open six days a week, with round-the-clock emergency care.</p>
        <div class="btn-group">
          <a href="/contact-us" class="btn btn-primary">
            Schedule a Consultation
          </a>
          <a href="tel:8002477857" class="btn btn-outline">
            Call Emergency Desk: (800) 247-PULSE
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .about-hero {
    background: radial-gradient(circle at 50% 20%, rgba(224, 242, 254, 0.6) 0%, rgba(248, 250, 252, 1) 100%);
    padding: 5rem 0 4rem;
    border-bottom: 1px solid var(--border);
  }

  .about-hero-title {
    font-size: clamp(2.5rem, 4.5vw, 3.5rem);
    font-weight: 800;
    color: var(--dark);
    letter-spacing: -0.025em;
    margin-bottom: 0.75rem;
  }

  .about-hero-tagline {
    font-size: 1.25rem;
    color: var(--primary);
    font-weight: 600;
    margin-bottom: 3.5rem;
  }

  .about-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  .stat-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 1.75rem 1.25rem;
    box-shadow: var(--shadow-md);
  }

  .stat-num {
    display: block;
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--dark);
    line-height: 1.1;
    margin-bottom: 0.35rem;
  }

  .stat-lbl {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  /* Story Section */
  .story-section {
    background-color: #ffffff;
    padding: 5rem 0;
  }

  .story-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 4rem;
    align-items: center;
  }

  .story-rich-body {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text-main);
  }

  .core-values-card {
    background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%);
    border: 1.5px solid var(--primary-subtle);
    border-radius: var(--radius-xl);
    padding: 2.5rem;
    box-shadow: var(--shadow-md);
  }

  .core-values-card h3 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--dark);
    margin-bottom: 1.5rem;
  }

  .values-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .values-list li {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-main);
  }

  .values-list strong {
    color: var(--primary-hover);
    display: block;
    margin-bottom: 0.2rem;
  }

  /* Mission & Vision */
  .mission-vision-section {
    background-color: var(--bg-page);
    padding: 5rem 0;
  }

  .mission-vision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  .mv-card {
    background-color: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 3rem 2.5rem;
    box-shadow: var(--shadow-md);
  }

  .mv-icon {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .mv-card h3 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--dark);
    margin-bottom: 1rem;
  }

  .mv-card p {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* Team Section */
  .team-section {
    background-color: #ffffff;
    padding: 5rem 0;
  }

  .doctors-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 2rem;
    margin-top: 3.5rem;
  }

  /* Facilities */
  .facilities-section {
    background-color: var(--bg-page);
    padding: 5rem 0;
  }

  .facilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.75rem;
    margin-top: 3.5rem;
  }

  .facility-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2rem;
    box-shadow: var(--shadow-sm);
  }

  .facility-icon {
    font-size: 2.25rem;
    display: block;
    margin-bottom: 1rem;
  }

  .facility-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 0.5rem;
  }

  .facility-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  /* CTA Box */
  .about-cta-card {
    background: linear-gradient(135deg, var(--dark) 0%, #1e293b 100%);
    border-radius: var(--radius-xl);
    padding: 4rem 2rem;
    color: #ffffff;
  }

  .about-cta-card h2 {
    font-size: 2.25rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }

  .about-cta-card p {
    font-size: 1.1rem;
    color: #94a3b8;
    margin-bottom: 2rem;
  }

  .btn-group {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .story-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .mission-vision-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
