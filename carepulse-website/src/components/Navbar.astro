---
const pathname = Astro.url.pathname;
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/blogs', label: 'Health Tips' },
  { href: '/about-us', label: 'About Us' },
  { href: '/contact-us', label: 'Contact & Appointments' },
];
---

<header class="site-header">
  <div class="top-announcement">
    <div class="container announcement-inner">
      <div class="announcement-left">
        <span class="pulse-indicator"></span>
        <span>24/7 Emergency & Acute Trauma Care Available</span>
      </div>
      <div class="announcement-right">
        <a href="tel:8002477857" class="hotline-link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          Emergency Desk: <strong>(800) 247-PULSE</strong>
        </a>
        <span class="divider">|</span>
        <span class="location-text">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          Metro Central Campus
        </span>
      </div>
    </div>
  </div>

  <nav class="main-navbar">
    <div class="container navbar-inner">
      <!-- Logo -->
      <a href="/" class="brand-logo" aria-label="CarePulse Health Home">
        <div class="logo-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 12h-4l-3 9L9 3l-3 9H2"></path>
          </svg>
        </div>
        <div class="brand-text">
          <span class="brand-title">CarePulse</span>
          <span class="brand-subtitle">Health Portal</span>
        </div>
      </a>

      <!-- Desktop Links -->
      <ul class="nav-menu">
        {navLinks.map((link) => {
          const isActive = pathname === link.href || (link.href !== '/' && pathname.startsWith(link.href));
          return (
            <li class="nav-item">
              <a href={link.href} class:list={['nav-link', { active: isActive }]}>
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>

      <!-- CTA -->
      <div class="navbar-actions">
        <a href="/contact-us" class="btn btn-primary nav-cta">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="16" y1="2" x2="16" y2="6"></line>
            <line x1="8" y1="2" x2="8" y2="6"></line>
            <line x1="3" y1="10" x2="21" y2="10"></line>
          </svg>
          Book Appointment
        </a>

        <!-- Mobile Toggle Button -->
        <button id="mobileMenuBtn" class="mobile-toggle-btn" aria-label="Toggle navigation menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div id="mobileDrawer" class="mobile-drawer">
    <div class="mobile-drawer-content">
      <ul class="mobile-nav-list">
        {navLinks.map((link) => (
          <li>
            <a href={link.href} class="mobile-nav-link">
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-drawer-footer">
        <a href="/contact-us" class="btn btn-primary mobile-btn">
          Book Appointment Now
        </a>
        <div class="mobile-hotline">
          Emergency Call: <strong>(800) 247-PULSE</strong>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobileMenuBtn');
  const drawer = document.getElementById('mobileDrawer');

  if (toggleBtn && drawer) {
    toggleBtn.addEventListener('click', () => {
      drawer.classList.toggle('open');
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 3px 0 rgb(0 0 0 / 0.05);
  }

  .top-announcement {
    background-color: var(--dark);
    color: #cbd5e1;
    font-size: 0.8rem;
    padding: 0.45rem 0;
  }

  .announcement-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .announcement-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 500;
  }

  .announcement-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hotline-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #38bdf8;
    text-decoration: none;
  }

  .hotline-link:hover {
    color: #7dd3fc;
  }

  .location-text {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .divider {
    color: #475569;
  }

  .main-navbar {
    border-bottom: 1px solid var(--border);
  }

  .navbar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 76px;
  }

  .brand-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
  }

  .logo-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    box-shadow: 0 4px 10px rgba(2, 132, 199, 0.35);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--dark);
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .brand-subtitle {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--primary);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .nav-menu {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 0.5rem;
  }

  .nav-link {
    display: inline-block;
    padding: 0.5rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-muted);
    border-radius: var(--radius-sm);
    transition: var(--transition);
  }

  .nav-link:hover {
    color: var(--primary);
    background-color: var(--primary-light);
  }

  .nav-link.active {
    color: var(--primary);
    background-color: var(--primary-light);
  }

  .navbar-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .mobile-toggle-btn {
    display: none;
    padding: 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--dark);
  }

  .mobile-drawer {
    display: none;
    border-top: 1px solid var(--border);
    background-color: #ffffff;
    padding: 1.5rem;
  }

  .mobile-drawer.open {
    display: block;
  }

  .mobile-nav-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .mobile-nav-link {
    display: block;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--dark);
    padding: 0.5rem 0;
  }

  .mobile-btn {
    width: 100%;
    margin-bottom: 1rem;
  }

  .mobile-hotline {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  @media (max-width: 900px) {
    .nav-menu {
      display: none;
    }
    .mobile-toggle-btn {
      display: inline-flex;
    }
    .nav-cta {
      display: none;
    }
    .top-announcement .location-text,
    .top-announcement .divider {
      display: none;
    }
  }
</style>
