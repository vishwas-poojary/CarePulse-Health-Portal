---
interface Props {
  name: string;
  title: string;
  department: string;
  experience: string;
  focus: string;
  image?: string;
}

const { name, title, department, experience, focus } = Astro.props;
---

<div class="doctor-card">
  <div class="doctor-img-wrap">
    <div class="doctor-placeholder-art">
      <div class="doctor-symbol">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </div>
    </div>
    <span class="dept-badge">{department}</span>
  </div>

  <div class="doctor-info">
    <h3 class="doctor-title">{name}</h3>
    <p class="doctor-role">{title}</p>
    
    <div class="doctor-meta">
      <div class="meta-item">
        <span class="meta-label">Experience:</span>
        <span class="meta-value">{experience}</span>
      </div>
      <div class="meta-item">
        <span class="meta-label">Clinical Focus:</span>
        <span class="meta-value">{focus}</span>
      </div>
    </div>

    <div class="doctor-actions">
      <a href={`/contact-us?dept=${encodeURIComponent(department)}`} class="btn btn-outline book-doc-btn">
        Consult Specialist
      </a>
    </div>
  </div>
</div>

<style>
  .doctor-card {
    background-color: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: var(--transition);
    display: flex;
    flex-direction: column;
  }

  .doctor-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
    border-color: #cbd5e1;
  }

  .doctor-img-wrap {
    position: relative;
    height: 220px;
    background: linear-gradient(135deg, #e0f2fe 0%, #dbeafe 100%);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .doctor-symbol {
    width: 80px;
    height: 80px;
    background: #ffffff;
    color: var(--primary);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--shadow-md);
  }

  .dept-badge {
    position: absolute;
    bottom: 1rem;
    left: 1rem;
    background: rgba(15, 23, 42, 0.85);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    backdrop-filter: blur(4px);
  }

  .doctor-info {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .doctor-title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--dark);
    margin-bottom: 0.25rem;
  }

  .doctor-role {
    font-size: 0.875rem;
    color: var(--primary);
    font-weight: 600;
    margin-bottom: 1.25rem;
  }

  .doctor-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .meta-item {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    border-bottom: 1px dashed var(--border-light);
    padding-bottom: 0.35rem;
  }

  .meta-label {
    color: var(--text-muted);
  }

  .meta-value {
    font-weight: 600;
    color: var(--dark);
    text-align: right;
  }

  .book-doc-btn {
    width: 100%;
    font-size: 0.875rem;
    padding: 0.6rem;
  }
</style>
