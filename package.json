{
  "name": "carepulse-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint:code": "eslint .",
    "lint:spell": "cspell \"**/*.{ts,astro,md,json}\" --no-progress",
    "lint": "eslint . && npm run lint:spell",
    "security:gitleaks": "gitleaks detect --verbose --source .",
    "security:semgrep": "semgrep scan --config auto",
    "security:trivy": "trivy fs --config trivy.yaml ."
  },
  "dependencies": {
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "cspell": "^10.4.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript-eslint": "^8.71.2"
  }
}
