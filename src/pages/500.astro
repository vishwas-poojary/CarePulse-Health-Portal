---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="500 - System Error | CarePulse Health Portal"
  description="An unexpected system error occurred on the CarePulse Health portal. Patient records and clinical emergency services remain operational."
>
  <section class="error-page-section">
    <div class="container">
      <div class="error-card">
        <div class="error-status-badge">
          <span class="status-dot"></span>
          Error Code: 500
        </div>

        <div class="error-icon-wrapper">
          <svg
            class="error-icon"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
            <line x1="12" y1="9" x2="12" y2="13"></line>
            <line x1="12" y1="17" x2="12.01" y2="17"></line>
          </svg>
        </div>

        <h1 class="error-title">Temporary Clinical System Disruption</h1>
        <p class="error-description">
          Our servers encountered an unexpected condition while fulfilling this request.
          Rest assured, clinical records, patient appointment queues, and database integrity are completely secure.
        </p>

        <div class="error-actions-grid">
          <button id="retryButton" type="button" class="btn btn-primary">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="23 4 23 10 17 10"></polyline>
              <polyline points="1 20 1 14 7 14"></polyline>
              <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"></path>
            </svg>
            Reload Page
          </button>
          <a href="/" class="btn btn-outline">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
              <polyline points="9 22 9 12 15 12 15 22"></polyline>
            </svg>
            Return to Homepage
          </a>
          <a href="/contact-us" class="btn btn-outline">
            <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            Report Issue
          </a>
        </div>

        <div class="emergency-help-box">
          <div class="emergency-dot"></div>
          <div>
            <strong>Critical Patient Care:</strong>
            <span> If you need immediate medical attention, call <strong>+1 (800) CARE-PULSE</strong> or your local emergency number.</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const retryBtn = document.getElementById('retryButton');
    if (retryBtn) {
      retryBtn.addEventListener('click', () => {
        window.location.reload();
      });
    }
  </script>
</Layout>

<style>
  .error-page-section {
    padding: 6rem 1.5rem;
    min-height: 75vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: radial-gradient(circle at top center, rgba(239, 68, 68, 0.06) 0%, transparent 70%);
  }

  .error-card {
    max-width: 680px;
    margin: 0 auto;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    padding: 3.5rem 2.5rem;
    text-align: center;
    box-shadow: var(--shadow-xl);
  }

  .error-status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 1rem;
    border-radius: var(--radius-full);
    background: #fef2f2;
    color: var(--danger);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    margin-bottom: 1.5rem;
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--danger);
    animation: blink 1.5s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .error-icon-wrapper {
    width: 80px;
    height: 80px;
    margin: 0 auto 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #fef2f2;
    color: var(--danger);
  }

  .error-icon {
    width: 44px;
    height: 44px;
  }

  .error-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--dark);
    margin-bottom: 1rem;
    line-height: 1.25;
  }

  .error-description {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .error-actions-grid {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.6rem;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: var(--transition);
    text-decoration: none;
  }

  .btn-icon {
    width: 18px;
    height: 18px;
  }

  .btn-primary {
    background: var(--primary);
    color: #ffffff;
    box-shadow: 0 4px 14px 0 rgba(2, 132, 199, 0.35);
  }

  .btn-primary:hover {
    background: var(--primary-hover);
    transform: translateY(-2px);
  }

  .btn-outline {
    background: transparent;
    color: var(--dark);
    border: 1px solid var(--border);
  }

  .btn-outline:hover {
    background: var(--bg-page);
    border-color: var(--primary);
    color: var(--primary);
  }

  .emergency-help-box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    background: #fef2f2;
    border: 1px solid #fee2e2;
    color: #991b1b;
    font-size: 0.9rem;
    text-align: left;
  }

  .emergency-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--danger);
    flex-shrink: 0;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.4;
      transform: scale(1.2);
    }
  }

  @media (max-width: 640px) {
    .error-card {
      padding: 2.5rem 1.5rem;
    }
    .error-title {
      font-size: 1.6rem;
    }
    .error-actions-grid {
      flex-direction: column;
    }
    .btn {
      width: 100%;
    }
  }
</style>
